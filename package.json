{
  "name": "spec-lens",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "spec-lens": "./dist/server/cli.js"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch server/src/cli.ts serve",
    "dev:full": "concurrently \"pnpm dev:server\" \"pnpm dev\"",
    "build": "tsc -b && vite build && tsc -p server/tsconfig.json && chmod +x dist/server/cli.js",
    "build:server": "tsc -p server/tsconfig.json",
    "build:frontend": "tsc -b && vite build",
    "preview": "node dist/server/cli.js serve",
    "serve": "node dist/server/cli.js serve"
  },
  "dependencies": {
    "@xyflow/react": "^12.7.2",
    "chokidar": "^4.0.3",
    "dagre": "^0.8.5",
    "flexsearch": "^0.8.160",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.0",
    "lucide-react": "^1.16.0",
    "mermaid": "^11.6.0",
    "node-sql-parser": "^5.3.9",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-router": "^7.6.1",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "shiki": "^3.6.0",
    "ts-morph": "^25.0.1",
    "unified": "^11.0.5",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.7",
    "@types/dagre": "^0.7.52",
    "@types/js-yaml": "^4.0.9",
    "@types/mdast": "^4.0.4",
    "@types/node": "^25.8.0",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.2",
    "concurrently": "^9.2.1",
    "tailwindcss": "^4.1.7",
    "tsx": "^4.22.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
